<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Cofetăria Dulcelind</title>
    <meta name="description" content="Cofetaria Dulcelind ofera prajituri, torturi, produse de patiserie cu optiunea de achizitie online si livrare prin curier.">
    <meta name="keywords" content="cofetarie, Dulcelind, cofetaria Dulcelind, prajituri, torturi, dulce, pateuri, produse">
    <link href="/resurse/css/galerie-statica.css" type="text/css" rel="stylesheet" />
    <link href="/resurse/css/galerie-statica500.css" type="text/css" rel="stylesheet" media="(max-width:500px)"/>
